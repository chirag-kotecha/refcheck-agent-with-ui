# Copy to .env and fill in what you need, then:
#   docker run --env-file .env <image> run_demo_multi.py
# or locally: export $(grep -v '^#' .env | xargs)

# ---------------------------------------------------------------------------
# Real-time provider selection. One of: anthropic (default), bedrock, openrouter.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Anthropic direct API (needed if LLM_PROVIDER=anthropic, and always for
# the default Anthropic batch backend regardless of LLM_PROVIDER)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# AWS Bedrock (needed if LLM_PROVIDER=bedrock, and/or for the Bedrock
# batch backend via `run_batch_demo.py --provider bedrock`). Credentials
# are NOT set here -- use the standard AWS credential chain.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Required ONLY for the Bedrock BATCH backend (refcheck/llm/batch/bedrock_batch.py)
# -- not needed for real-time Bedrock calls via llm/bedrock_provider.py.
# BEDROCK_BATCH_S3_BUCKET=my-batch-bucket
# BEDROCK_BATCH_S3_INPUT_PREFIX=refcheck-batch/input
# BEDROCK_BATCH_S3_OUTPUT_PREFIX=refcheck-batch/output
# BEDROCK_BATCH_ROLE_ARN=arn:aws:iam::123456789012:role/BedrockBatchRole
# BEDROCK_BATCH_JOB_NAME_PREFIX=refcheck-batch
# BEDROCK_BATCH_POLL_INTERVAL_SECONDS=30
# BEDROCK_BATCH_MAX_WAIT_SECONDS=14400

# ---------------------------------------------------------------------------
# OpenRouter (needed if LLM_PROVIDER=openrouter)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Model tiering overrides (optional). Format: MODEL_<PROVIDER>_<TIER>
# ---------------------------------------------------------------------------
# MODEL_ANTHROPIC_EXTRACTION=claude-haiku-4-5
# MODEL_ANTHROPIC_REASONING=claude-sonnet-4-6
# MODEL_BEDROCK_EXTRACTION=anthropic.claude-haiku-4-5-v1:0
# MODEL_BEDROCK_REASONING=anthropic.claude-sonnet-4-6-v1:0
# MODEL_OPENROUTER_EXTRACTION=anthropic/claude-haiku-4.5
# MODEL_OPENROUTER_REASONING=anthropic/claude-sonnet-4.6

# ---------------------------------------------------------------------------
# Prompt caching (optional -- off by default)
# ---------------------------------------------------------------------------
ENABLE_PROMPT_CACHING=false

# ---------------------------------------------------------------------------
# Streamlit UI -> API base URL (only needed running locally without
# docker-compose, which sets this automatically for the containerized
# setup -- see docker-compose.yml's `streamlit` service)
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LLM call behavior (optional overrides)
# ---------------------------------------------------------------------------
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=1
LLM_RETRY_MAX_WAIT_SECONDS=20

# ---------------------------------------------------------------------------
# Scoring thresholds / penalty weights (optional overrides)
# ---------------------------------------------------------------------------
MINOR_MONTH_TOLERANCE=1
MODERATE_MONTH_TOLERANCE=6
PENALTY_MINOR=5
PENALTY_MODERATE=15
PENALTY_MAJOR=35
PENALTY_SENTIMENT_NEGATIVE=20
PENALTY_SENTIMENT_MIXED=10
PENALTY_RED_FLAG=10
REVIEW_THRESHOLD=70
OVERALL_REVIEW_THRESHOLD=70

# ---------------------------------------------------------------------------
# Concurrency / input limits (optional overrides)
# ---------------------------------------------------------------------------
MAX_CONCURRENT_REFERENCES=5
MAX_RAW_INPUT_CHARS=20000
MIN_RAW_INPUT_CHARS=10

# ---------------------------------------------------------------------------
# Anthropic batch (optional overrides)
# ---------------------------------------------------------------------------
BATCH_POLL_INTERVAL_SECONDS=15
BATCH_MAX_WAIT_SECONDS=7200
